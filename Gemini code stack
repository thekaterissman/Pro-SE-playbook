import os
from google import genai
from google.genai import types

class GeminiCodeStack:
    """
    Gemini Code Stack: The native developer integration bridging Google AI Studio,
    the Interactions API, and the Infinity Grid runtime.
    """
    def __init__(self, model_id: str = "gemini-2.5-flash"):
        self.client = genai.Client()
        self.model_id = model_id
        print("[GEMINI CODE STACK] Initialized connection to Google AI Studio.")

    def run_inference(self, system_instruction: str, payload: str) -> str:
        """
        Executes a high-precision, low-temperature multimodal generation pass
        optimized for technical code generation, agentic orchestration, and document analysis.
        """
        response = self.client.models.generate_content(
            model=self.model_id,
            contents=payload,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction,
                temperature=0.1,
                max_output_tokens=4096,
            )
        )
        return response.text

if __name__ == "__main__":
    stack = GeminiCodeStack()
    sys_instruct = "You are the core execution runtime for the Pro Se Playbook and Infinity Grid Stack."
    user_payload = "Initialize repository integration: https://github.com/thekaterissman/Pro-SE-playbook.git"
    
    output = stack.run_inference(sys_instruct, user_payload)
    print("\n--- Gemini Code Stack Output ---")
    print(output)
